# Ignore runtime cache and user data
data/
.cache/
src/
*.flag
*.log

# Personal Obsidian brain (long-term memory) — travels on the drive, NOT in the public repo.
# Sync it to a PRIVATE repo if you want it backed up.
Brain/

# Session handoff / scratch notes (per-OS handoff prompts stay on the USB, never published)
*-HANDOFF-PROMPT.md
*.console.err

# Claude Code local workspace config (per-machine, not for the public repo)
.claude/

# macOS junk (AppleDouble + Finder metadata) — appears on exFAT/FAT drives
._*
.DS_Store

# Portable Chrome profile + downloads (contain credentials, cookies, cached data)
chrome-profile/
chrome-downloads/
