# Hermes-USB-Portable — version pin
# Pairs the portable wrapper version with the exact bundled hermes-agent it ships.

portable_version:        portable-v1.4.1
hermes_agent_version:    0.16.0
hermes_agent_upstream:   NousResearch/hermes-agent
hermes_agent_commit:     56236b16e383cc656bb8c88429902f4de83f1faf
synced_on:               2026-06-06

# v1.4.1 — launch.bat one-shot fix: `launch.bat -z "a, b (c)"` (any quoted
#          passthrough args) died with "is was unexpected at this time" because
#          `if not "%ARGS%"=="" ( hermes %ARGS% )` expanded the quoted args at
#          parse time. Now detects args via %~1 and runs `hermes !ARGS!` on a
#          bare line with delayed expansion. macOS launch.sh already worked. See CHANGELOG.md.
# v1.4.0 — Windows launcher parity: port the "Google Gemini — Login with Google"
#          (OAuth, google-gemini-cli, no API key) option into launch.bat. It had
#          shipped in launch.sh at v1.2.0 but Windows was stuck on the API-key-only
#          Gemini menu (provider "gemini" + GEMINI_API_KEY) — which silently failed
#          for OAuth users. Model menu now uses set/p so the 2-digit "[10] Back"
#          works. macOS launch.sh unchanged. See CHANGELOG.md.
# v1.3.1 — dashboard launcher fix: start the server detached with --no-open and
#          poll until it actually binds (cold start is ~60-90s on USB) BEFORE
#          opening the browser, so it no longer lands on a connection-refused
#          page. Adds an "already running" fast-path. See CHANGELOG.md.
# v1.3.0 — added "[D] Open Dashboard" launcher option: serves hermes-agent's web
#          UI (FastAPI + prebuilt Vite SPA) at http://127.0.0.1:9119 via
#          `hermes dashboard --skip-build`. Frontend pre-built onto the drive
#          (hermes_cli/web_dist); fastapi/uvicorn ride the [all] extra. See
#          CHANGELOG.md + docs/DASHBOARD.md.
# v1.2.0 — added "Google Gemini — Login with Google" model option (OAuth, no API
#          key) wiring hermes-agent's native google-gemini-cli provider into the
#          launcher's model menu. See CHANGELOG.md + docs/GEMINI-LOGIN.md.
# v1.1.0 — added "Eject USB Safely" launcher option + scripts/safe-eject.sh
#          (save sessions -> organise/verify Brain -> sync -> eject). See CHANGELOG.md.

# Notes:
# - The hermes-agent source lives in src/ (gitignored); the launchers download it
